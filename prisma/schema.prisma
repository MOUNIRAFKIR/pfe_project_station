generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- LES MODELS DYAL E-PARKING ----

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  bio       String?
  image     String?
  role      String   @default("USER") // USER wla ADMIN
  createdAt DateTime @default(now())

  reservations Reservation[]
}

model Parking {
  id          String   @id @default(cuid())
  name        String
  address     String
  totalSpots  Int
  pricePerHour Float
  latitude    Float?
  longitude   Float?
  
  spots       Spot[]
  reservations Reservation[]
}

model Spot {
  id        String  @id @default(cuid())
  spotNumber String
  isBooked  Boolean @default(false)
  parkingId String
  parking   Parking @relation(fields: [parkingId], references: [id])

  reservations Reservation[]
}

model Reservation {
  id        String   @id @default(cuid())
  userId    String
  parkingId String
  spotId    String
  startTime DateTime
  endTime   DateTime
  status    String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED

  user    User    @relation(fields: [userId], references: [id])
  parking Parking @relation(fields: [parkingId], references: [id])
  spot    Spot    @relation(fields: [spotId], references: [id])
}